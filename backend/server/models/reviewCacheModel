const mongoose = require("mongoose");

//plot schema/model
const reviewCacheSchema = new mongoose.Schema(
  {
    review: {
        type: String,
        required: true,
        label: "review"
    },
    omdbId: {
      type: Number,
      required: true,
      label: "omdbId"
    },
    date: {
      type: Date,
      default: Date.now,
    }
  },
  { collection: "reviewCache" }
);

module.exports = mongoose.model('reviewCache', reviewCacheSchema)